<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>Breakwater.Analyzers</PackageId>
    <Description>Roslyn analyzer that flags unsafe EF Core migrations (table locks, data loss, breaking changes for rolling deploys) at build time.</Description>
    <PackageTags>efcore;entity-framework-core;migrations;roslyn;analyzer;static-analysis;zero-downtime</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/FelixMiddelhoff/breakwater</PackageProjectUrl>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- Descriptors are built by RuleDescriptors.Create, which release tracking cannot follow. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-time only: the consumer's compiler already provides Roslyn. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.0.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the SQL tokenizer (Sql/) be unit-tested directly, not only through the analyzer. -->
    <InternalsVisibleTo Include="Breakwater.Analyzers.Tests" />
  </ItemGroup>

</Project>
