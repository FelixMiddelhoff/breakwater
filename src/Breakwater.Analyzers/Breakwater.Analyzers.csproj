<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>Breakwater.Analyzers</PackageId>
    <Description>Roslyn analyzer that flags unsafe EF Core migrations (table locks, data loss, breaking changes for rolling deploys) at build time.</Description>
    <PackageTags>efcore;entity-framework-core;ef-core-migrations;migrations;database-migrations;schema-migration;migration-safety;roslyn;roslyn-analyzer;analyzer;static-analysis;code-quality;linter;zero-downtime;database;sql-server;postgresql;csharp;dotnet;devops;ci-cd</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/FelixMiddelhoff/breakwater</PackageProjectUrl>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- Descriptors are built by RuleDescriptors.Create, which release tracking cannot follow. -->
    <!-- RS1038: the Workspaces reference below is isolated to CodeFixes/ (CodeFixProvider/CodeAction);
         DiagnosticAnalyzer types never touch it, so plain command-line compilation is unaffected. -->
    <NoWarn>$(NoWarn);RS2008;RS1038</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-time only: the consumer's compiler already provides Roslyn. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0-1.26328.17" PrivateAssets="all" />
    <!-- CodeFixProvider/CodeAction live in Workspaces, needed only by CodeFixes/. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <!-- IncludeBuildOutput=false means the symbols package would otherwise have nothing to hold. -->
    <AllowedOutputExtensionsInSymbolsPackageBuildOutputFolder>.pdb</AllowedOutputExtensionsInSymbolsPackageBuildOutputFolder>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(OutputPath)\$(AssemblyName).pdb" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the SQL tokenizer (Sql/) be unit-tested directly, not only through the analyzer. -->
    <InternalsVisibleTo Include="Breakwater.Analyzers.Tests" />
    <!-- Lets Breakwater.Tool (the "dotnet ef migrations script" linter) reuse Sql/SqlTokenizer.cs,
         Sql/SqlStatementRisk.cs, and Configuration/BreakwaterDatabaseProvider.cs directly instead
         of duplicating the tokenizer or the provider enum in a second project. -->
    <InternalsVisibleTo Include="Breakwater.Tool" />
    <!-- Breakwater.Tool.Tests asserts against BreakwaterDatabaseProvider directly (the same enum
         the tool's "provider" command-line flag parses into), same reasoning as the entry above. -->
    <InternalsVisibleTo Include="Breakwater.Tool.Tests" />
  </ItemGroup>

</Project>
